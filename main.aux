\@writefile{toc}{\contentsline {section}{\numberline {I}Introduction}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Coordinated mission conducted by a fleet of homogeneous robots in a forested area, The diagram illustrates a hierarchical control architecture for robotic movement. The High-Level Policy generates strategic decisions that are refined by a pertained foundation locomotion model(RL) Low-Level Policy to control the robot's actions. The Vision Policy, using Convolutional Neural Networks (CNNs), processes visual inputs to guide the Multi-Agent Transformer (MAT), which integrates sensory data for decision-making. This system dynamically interacts with the all of the robot’s State, influencing its actions and subsequent Rewards, optimizing behavior through continuous feedback.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:team_spot_drone2}{{1}{1}{Coordinated mission conducted by a fleet of homogeneous robots in a forested area, The diagram illustrates a hierarchical control architecture for robotic movement. The High-Level Policy generates strategic decisions that are refined by a pertained foundation locomotion model(RL) Low-Level Policy to control the robot's actions. The Vision Policy, using Convolutional Neural Networks (CNNs), processes visual inputs to guide the Multi-Agent Transformer (MAT), which integrates sensory data for decision-making. This system dynamically interacts with the all of the robot’s State, influencing its actions and subsequent Rewards, optimizing behavior through continuous feedback}{figure.caption.1}{}}
